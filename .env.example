# Local-only Model Studio configuration. Copy to .env and replace the empty key.
DASHSCOPE_API_KEY=
CLAIMGUARD_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLAIMGUARD_EMBEDDING_MODEL=qwen3.7-text-embedding
CLAIMGUARD_EMBEDDING_DIMENSIONS=1024
CLAIMGUARD_SEMANTIC_MODEL=qwen3.7-plus
CLAIMGUARD_ROUTER_MODEL=qwen3.8-flash
CLAIMGUARD_POLICY_MODEL=qwen3.7-plus
CLAIMGUARD_OPENAI_TRACING_ENABLED=false
